# Application
APP_NAME="Child DNA API"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://child_dna:password@localhost:5432/child_dna

# JWT
JWT_SECRET_KEY=your-secret-key-min-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json